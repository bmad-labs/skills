@startuml 00-overview
!include _style.iuml
title 00 — One order, end to end (phase 1)

box "Client" #E8EAF6
    actor "Customer" as U
end box
box "order-service" #E8F5E9
    participant "order-intake" as IN
    participant "payment" as PAY
end box
box "External" #FFEBEE
    participant "Fraud vendor" as FR
    participant "Payment Gateway" as GW
    queue "Kafka\ndomain events" as K
end box

== 1 · Place (see 01) ==
U -> IN : PlaceOrder
activate IN $UC
IN -> K : ORD101 Order Placed
IN --> U : order id
deactivate IN

== 2 · Check (see 02) ==
K -> PAY : ORD101
activate PAY $UC
PAY -> FR : ORD111 Fraud Check Requested
activate FR $EXT
FR --> PAY : FRD001 score
deactivate FR

== 3 · Charge (see 03) ==
PAY -> GW : createCharge (key orderId)
activate GW $EXT
GW --> PAY : accepted or failed
deactivate GW
PAY -> K : ORD102 Paid, or ORD103 Payment Failed
deactivate PAY
@enduml
